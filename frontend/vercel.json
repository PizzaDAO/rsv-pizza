{
  "redirects": [
    {
      "source": "/santacruzdelasierra",
      "destination": "/santacruz",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/cdn/:path*",
      "destination": "https://znpiwdvvsqaxuskpfleo.supabase.co/storage/v1/object/public/:path*"
    },
    {
      "source": "/((?!assets/|cdn/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/auth/verify",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/cdn/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
