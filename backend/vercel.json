{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 300 }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/send-surveys",
      "schedule": "0 * * * *"
    },
    { "path": "/api/cron/nft-claims", "schedule": "15 * * * *" },
    { "path": "/api/cron/event-reminders", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/cleanup-pizza-submissions", "schedule": "30 4 * * *" },
    { "path": "/api/cron/cleanup-hackathon-uploads", "schedule": "45 4 * * *" },
    { "path": "/api/cron/cleanup-brand-uploads", "schedule": "50 4 * * *" },
    { "path": "/api/cron/recheck-domains", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/recheck-live-domains", "schedule": "40 5 * * *" },
    { "path": "/api/cron/recheck-email-domains", "schedule": "20 * * * *" }
  ]
}
