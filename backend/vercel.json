{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 300 }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/cron/send-surveys",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/send-host-surveys",
      "schedule": "0 * * * *"
    },
    { "path": "/api/cron/event-reminders", "schedule": "*/15 * * * *" }
  ]
}
