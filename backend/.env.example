# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rsvpizza

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Frontend URL (for CORS and magic links)
FRONTEND_URL=http://localhost:5176

# Server
PORT=3006
NODE_ENV=development

# --- White-label brand config (all optional) ---
# Unset => RSV.Pizza defaults, so leaving these blank changes nothing.
# See src/config/brand.ts and plans/whitelabel-brand-config.md.
BRAND_NAME=RSV.Pizza
BRAND_DOMAIN=rsv.pizza
BRAND_API_DOMAIN=api.rsv.pizza
BRAND_NOREPLY_EMAIL=noreply@rsv.pizza
BRAND_SUPPORT_EMAIL=help@rsv.pizza

# --- AI ordering through pizza-mcp (basil-14648; OFF unless PIZZA_ORDERING_PARTY_IDS is set) ---
# Full runbook: docs/ai-ordering-pilot.md
# Base URL of pizza-mcp, no trailing slash. Also the default token audience.
PIZZA_MCP_URL=
# Only if pizza-mcp expects the audience with the /api/mcp suffix. Default: PIZZA_MCP_URL.
PIZZA_MCP_AUDIENCE=
# `iss` of our tokens; must equal the issuer in pizza-mcp's PIZZA_MCP_TRUSTED_ISSUERS. Default: https://api.rsv.pizza
PIZZA_MCP_ISSUER=
# ES256 private key (PKCS8 PEM; \n escapes ok). Create with: bash backend/scripts/gen-pizza-mcp-key.sh
PIZZA_MCP_SIGNING_KEY=
# Optional kid override, and public JWKs of an old key to keep publishing during rotation (JSON array).
PIZZA_MCP_SIGNING_KID=
PIZZA_MCP_JWKS_EXTRA=
# Shared secret for pizza-mcp's order.updated webhooks (same value as in its PIZZA_MCP_CLIENT_WEBHOOKS). Comma separated while rotating.
PIZZA_MCP_WEBHOOK_SECRET=
# Comma separated party ids allowed to use AI ordering. Empty = off for everyone.
PIZZA_ORDERING_PARTY_IDS=
