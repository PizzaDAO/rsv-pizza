# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rsvpizza

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Frontend URL (for CORS and magic links)
FRONTEND_URL=http://localhost:5176

# Server
PORT=3006
NODE_ENV=development

# --- White-label brand config (all optional) ---
# Unset => RSV.Pizza defaults, so leaving these blank changes nothing.
# See src/config/brand.ts and plans/whitelabel-brand-config.md.
BRAND_NAME=RSV.Pizza
BRAND_DOMAIN=rsv.pizza
BRAND_API_DOMAIN=api.rsv.pizza
BRAND_NOREPLY_EMAIL=noreply@rsv.pizza
BRAND_SUPPORT_EMAIL=help@rsv.pizza
