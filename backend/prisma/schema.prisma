  id      String @id @default(uuid()) @db.Uuid
  partyId String @map("party_id") @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  // Basic Info
  name             String // Sponsor/company name
  website          String? // Company website
  brandTwitter     String? @map("brand_twitter") // Brand's X/Twitter handle
  brandInstagram   String? @map("brand_instagram") // Brand's Instagram handle
  brandDescription String? @map("brand_description") // 1-2 sentence brand description

  // Contact Info
  pointPerson    String? @map("point_person") // Who's managing this relationship
  contactName    String? @map("contact_name") // Contact at the sponsor company
  contactEmail   String? @map("contact_email")
  contactPhone   String? @map("contact_phone")
  contactTwitter String? @map("contact_twitter") // Contact person's X/Twitter handle
  telegram       String? // Telegram handle

  // Pipeline Status: todo, asked, yes, billed, paid, stuck, alum, skip
  status String @default("todo")

  // Fundraising
  amount          Decimal? @db.Decimal(10, 2) // Contribution amount
  sponsorshipType String?  @map("sponsorship_type") // cash, in-kind, venue, pizza, drinks, community, other
  productService  String?  @map("product_service") // For non-monetary contributions

  // Assets (for confirmed sponsors)
  logoUrl String? @map("logo_url")

  // Category
  category String? // hardware_wallet, software_wallet, cex, blockchain, dex, community, custom

  // Tracking
  notes           String? // Communication history, notes
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz

  // Intake form
  intakeToken       String?   @unique @map("intake_token")
  intakeSubmittedAt DateTime? @map("intake_submitted_at") @db.Timestamptz
  sponsorMessage    String?   @map("sponsor_message")

  // Whether this sponsor was bulk-added by an underboss (contact info hidden from hosts)
  addedByUnderboss Boolean @default(false) @map("added_by_underboss")

  // Display order (for flyer logo row)
  sortOrder Int @default(0) @map("sort_order")

  // Metadata
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  quizQuestions QuizQuestion[]

  invoices          Invoice[]
  mous              Mou[]

  @@index([partyId, status])
  @@index([partyId, createdAt])
  @@index([partyId, sortOrder])
  @@map("sponsors")
}

