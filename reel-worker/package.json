{
  "name": "rsvpizza-reel-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders sizzle reels (ffmpeg slideshow) for queued rows in the reels table and uploads them to R2.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@resvg/resvg-js": "^2.6.2",
    "pg": "^8.13.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
